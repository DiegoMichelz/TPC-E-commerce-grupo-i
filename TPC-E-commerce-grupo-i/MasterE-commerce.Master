<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="MasterE-commerce.master.cs" Inherits="TPC_E_commerce_grupo_i.MasterE_commerce" %>
<!DOCTYPE html>
<html>
<head runat="server">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>Mi E-commerce</title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div>
            <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
                <div class="container-fluid">
                    <a class="navbar-brand" href="~/Default.aspx" runat="server">Mi E-commerce</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navbarNav">
                        <ul class="navbar-nav">
                            <li class="nav-item"><a class="nav-link" href="~/Default.aspx" runat="server">Inicio</a></li>
                            <li class="nav-item"><a class="nav-link" href="~/Default.aspx#catalogo-seccion" runat="server">Catálogo</a></li>
                            <li class="nav-item"><a class="nav-link" href="~/Carrito.aspx" runat="server">Carrito</a></li>
                            
                            <% if (Session["usuario"] != null && ((TPC_E_commerce_grupo_i.Models.Usuario)Session["usuario"]).Admin) { %>
                                <li class="nav-item"><a class="nav-link text-warning fw-semibold" href="~/Administracion.aspx" runat="server">Administración</a></li>
                            <% } %>
                        </ul>

                        <!-- BLOQUE DE LOGIN / REGISTRO / PERFIL A LA DERECHA -->
                        <div class="navbar-nav ms-auto align-items-center">
                            <% if (Session["usuario"] != null)
                               {
                                   var user = (TPC_E_commerce_grupo_i.Models.Usuario)Session["usuario"];
                            %>
                                <a href="MiPerfil.aspx" class="nav-link text-white fw-semibold small me-3">
                                    <i class="bi bi-person-circle text-info me-1"></i>Hola, <%: !string.IsNullOrEmpty(user.Nombre) ? user.Nombre : user.Email %> (Mi Perfil)
                                </a>
                                <asp:Button ID="btnCerrarSesion" runat="server" Text="Cerrar Sesión" CssClass="btn btn-outline-danger btn-sm" OnClick="btnCerrarSesion_Click" />
                            <% }
                               else
                               { %>
                                <a href="Login.aspx" class="btn btn-outline-light btn-sm me-2">Iniciar Sesión</a>
                                <a href="Registro.aspx" class="btn btn-primary btn-sm">Registrarse</a>
                            <% } %>
                        </div>
                    </div>
                </div>
            </nav>
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>
    </form>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
